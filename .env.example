# Copia este archivo como .env y ajusta los valores. Nunca subas .env a Git.

# URI del servidor de MLflow (se levanta con `make mlflow`). Por defecto: http://127.0.0.1:5000
# En macOS el puerto 5000 lo ocupa AirPlay Receiver (responde 403). Opciones:
#   - desactivar AirPlay Receiver en Ajustes del Sistema > General > AirDrop y Handoff, o
#   - usar otro puerto: `make mlflow MLFLOW_PORT=5001` y descomentar la línea siguiente.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# --- Docker Compose (docker-compose.yml). Todas son opcionales; estos son los valores por defecto.
# Puertos publicados en el host (dentro de la red del stack: api:8000 y mlflow:5000)
# API_HOST_PORT=8000
# MLFLOW_HOST_PORT=5001
# Procesos de Uvicorn de la API (cada uno carga el modelo) y del servidor de MLflow
# API_WORKERS=1
# MLFLOW_WORKERS=1
# Límites de recursos por contenedor: equivalen a una instancia de referencia para FinOps
# API_CPUS=2
# API_MEMORIA=2g
# MLFLOW_CPUS=1
# MLFLOW_MEMORIA=1g
# Modelo que sirve la API dentro del stack (alias o versión fija del registry del stack)
# MODEL_URI=models:/mibici-equipo16-p1-demanda@champion
# Etiqueta de la imagen construida (CI usa el commit)
# IMAGEN_TAG=local
