# Copia este archivo como .env y ajusta los valores. Nunca subas .env a Git.

# URI de seguimiento de MLflow. Por defecto se usa sqlite:///<repo>/mlflow.db.
# Si levantas un servidor, evita el puerto 5000 en macOS (lo ocupa AirPlay Receiver):
#   mlflow server --backend-store-uri sqlite:///mlflow.db --port 5001
# MLFLOW_TRACKING_URI=http://127.0.0.1:5001
